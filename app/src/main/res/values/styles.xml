<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Post-splash main application theme -->
    <style name="Theme.RawMilk" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F4F3ED</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- Theme to use during splash screen launch (Android 12+ compatibility API) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#F4F3ED</item>
        <!-- Icon to center on the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <!-- Duration the splash screen stays (managed programmatically as well) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Theme to transition to once the splash screen is dismissed -->
        <item name="postSplashScreenTheme">@style/Theme.RawMilk</item>
    </style>

    <!-- Theme for Custom Splash Screen -->
    <style name="Theme.RawMilk.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F4F3ED</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
